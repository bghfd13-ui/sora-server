# Domain whose DNS A-record points at the server public IP.
SORA_DOMAIN=sora.example.com
POSTGRES_DB=sora
POSTGRES_USER=sora
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate every secret separately: openssl rand -base64 48
Jwt__Sessions=replace-with-a-long-random-secret
Authorization=replace-with-a-long-random-secret
GameServerAuthorization=replace-with-a-long-random-secret
BotAuthorization=replace-with-a-long-random-secret
RccAuthorization=replace-with-a-long-random-secret
ArbiterAuthorization=replace-with-a-long-random-secret
UserAgentBypassSecret=replace-with-a-long-random-secret
VerificationSecret=replace-with-a-long-random-secret
OwnerUserId__0=1
