@page "/internal/create-place"
@model Roblox.Website.Pages.Internal.CreatePlace

@{
    Layout = "Shared/_Layout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-6 offset-md-3">
            <div class="card card-body bg-dark text-light">
                <h3>Create a Game</h3>

                @if (Model.successUrl != null)
                {
                    <p class="mt-4 mb-4">
                        <span class="text-success">Game created successfully.</span>
                        <a href="@Model.successUrl">Open the place editor</a>.
                    </p>
                }
                else if (Model.errorMessage != null)
                {
                    <p class="mt-4 mb-4">
                        <span class="text-danger">@Model.errorMessage</span>
                    </p>
                }

                @if (Model.successUrl == null)
                {
                    <p>Create a new Place and its Universe.</p>

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="submit" class="btn btn-primary" value="Create Game" />
                    </form>
                }
            </div>
        </div>
    </div>
</div>
