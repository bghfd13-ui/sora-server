@page "/auth/accountlogin"
@model Roblox.Website.Pages.Auth.Login

@{
    Layout = null;
    var has2FAError = Model.errorMessage != null && Model.errorMessage.Contains("2FA");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log In - Sora</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            background: #f1f3f5;
            font-family: Arial, Helvetica, sans-serif;
            color: #111;
        }

        .login-wrapper {
            width: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding-top: 31px;
        }

        .login-card {
            width: 420px;
            max-width: calc(100% - 32px);
            background: #fff;
            border: 1px solid #d2d6da;
            border-radius: 3px;
            padding: 29px 34px 32px 34px;
        }

        .login-title {
            margin: 0;
            text-align: center;
            font-size: 32px;
            line-height: 38px;
            font-weight: 700;
        }

        .login-subtitle {
            margin: 8px 0 27px 0;
            text-align: center;
            color: #777;
            font-size: 14px;
        }

        .field-label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 700;
        }

        .login-input {
            width: 100%;
            height: 34px;
            padding: 7px 10px;
            margin-bottom: 16px;
            border: 1px solid #d7dce1;
            border-radius: 5px;
            background: #fff;
            color: #222;
            font-size: 14px;
            outline: none;
        }

        .login-input:focus {
            border-color: #80bdff;
            box-shadow: 0 0 0 2px rgba(0,123,255,.10);
        }

        .login-button {
            width: 100%;
            height: 35px;
            border: 0;
            border-radius: 5px;
            background: #68b393;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 2px;
        }

        .login-button:hover {
            background: #5da887;
        }

        .login-button:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

        .bottom-text {
            margin-top: 20px;
            text-align: center;
            font-size: 14px;
            color: #666;
        }

        .bottom-text a {
            color: #007bff;
            text-decoration: none;
        }

        .bottom-text a:hover {
            text-decoration: underline;
        }

        .error {
            margin-bottom: 18px;
            padding: 10px 12px;
            border: 1px solid #f1b5b5;
            border-radius: 4px;
            background: #fff0f0;
            color: #b00020;
            font-size: 14px;
        }

        .twofa {
            margin-top: 2px;
        }

        .secondary-link {
            display: block;
            margin-top: 12px;
            text-align: center;
            color: #007bff;
            text-decoration: none;
            font-size: 14px;
        }

        .secondary-link:hover {
            text-decoration: underline;
        }

        @@media (max-width: 480px) {
            .login-wrapper {
                padding-top: 20px;
            }

            .login-card {
                padding: 25px 24px 28px 24px;
            }

            .login-title {
                font-size: 29px;
            }
        }
    </style>
</head>

<body>
    <div class="login-wrapper">
        <div class="login-card">

            <h1 class="login-title">Log In</h1>

            <div class="login-subtitle">
                Log in to your Sora account
            </div>

            @if (Model.errorMessage != null)
            {
                <div class="error">
                    @Model.errorMessage
                </div>
            }

            <form method="post">

                @if (Model.applicationId != null)
                {
                    <input type="hidden"
                           name="applicationId"
                           value="@Model.applicationId" />
                }

                @Html.AntiForgeryToken()

                <label class="field-label" for="username">
                    Username
                </label>

                <input
                    id="username"
                    name="username"
                    type="text"
                    class="login-input"
                    autocomplete="username"
                    required
                    disabled="@Model.loginDisabled" />

                <label class="field-label" for="password">
                    Password
                </label>

                <input
                    id="password"
                    name="password"
                    type="password"
                    class="login-input"
                    autocomplete="current-password"
                    required
                    disabled="@Model.loginDisabled" />

                @if (has2FAError)
                {
                    <div class="twofa">
                        <label class="field-label" for="totpcode">
                            2FA Code
                        </label>

                        <input
                            id="totpcode"
                            name="totpcode"
                            type="text"
                            class="login-input"
                            autocomplete="one-time-code"
                            inputmode="numeric"
                            minlength="6"
                            maxlength="6"
                            pattern="[0-9]*"
                            disabled="@Model.loginDisabled" />
                    </div>
                }

                <button
                    id="login-submit"
                    class="login-button"
                    type="submit"
                    disabled="@Model.loginDisabled">
                    Log In
                </button>

                @if (Model.resetPasswordEnabled)
                {
                    <a class="secondary-link" href="/auth/password-reset">
                        Forgot your password?
                    </a>
                }

            </form>

            <div class="bottom-text">
                New to Sora?
                @if (Model.applicationId != null)
                {
                    <a href="/auth/signup?applicationId=@Model.applicationId">
                        Create an account
                    </a>
                }
                else
                {
                    <a href="/auth/signup">
                        Create an account
                    </a>
                }
            </div>

        </div>
    </div>
</body>
</html>
