@{
    Layout = null;
}
<!doctype html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="icon" type="image/x-icon" href="/favicon.png">
    <style>
        .btn-custom {
        padding: 0.5rem 1rem;
        font-weight: 600;
        border-radius: 0.375rem;
        transition: background-color 0.2s ease-in-out;
        }

        .btn-discord {
        background-color: #5865f2;
        color: white;
        padding: 0.5rem 1rem;
        font-weight: 600;
        border-radius: 0.375rem;
        border: none;
        }

        .btn-discord:hover {
        background-color: #4752c4;
        color: white;
        }

        .btn-discord:focus, .btn-discord.focus {
        box-shadow: 0 0 0 0.25rem rgba(86, 101, 242, 0.5);
        }

        /* Sora account/profile control */
        .sora-account-area {
            display: flex;
            align-items: center;
            margin-left: auto;
        }

        .sora-login-button,
        .sora-account-button {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            min-height: 42px;
            padding: 0.25rem 0.55rem;
            border: 0;
            border-radius: 0.375rem;
            background: transparent;
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
            font-size: 1rem;
            font-weight: 400;
            transition: background-color 0.15s ease-in-out, color 0.15s ease-in-out;
        }

        .sora-login-button:hover,
        .sora-account-button:hover,
        .sora-account-button:focus {
            background-color: rgba(255, 255, 255, 0.08);
            color: #fff;
            text-decoration: none;
        }

        .sora-login-icon {
            font-size: 1.65rem;
            line-height: 1;
        }

        .sora-account-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            background-color: #343a40;
            border: 1px solid rgba(255, 255, 255, 0.18);
            flex-shrink: 0;
        }

        .sora-account-menu {
            min-width: 190px;
            margin-top: 0.4rem;
            padding: 0.35rem;
            background-color: #212529;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 0.375rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.35);
        }

        .sora-account-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            border-radius: 0.3rem;
            color: rgba(255, 255, 255, 0.9);
        }

        .sora-account-item:hover,
        .sora-account-item:focus {
            background-color: rgba(255, 255, 255, 0.08);
            color: #fff;
        }

        .sora-account-menu .dropdown-divider {
            border-top-color: rgba(255, 255, 255, 0.1);
        }

        .sora-logout-button {
            width: 100%;
            border: 0;
            text-align: left;
        }

        @media (max-width: 991.98px) {
            .sora-account-area {
                margin-left: 0;
                margin-top: 0.5rem;
                padding-bottom: 0.5rem;
            }

            .sora-account-button,
            .sora-login-button {
                padding-left: 0;
            }
        }
    </style>
    @await RenderSectionAsync("MetaTags", required: false)
</head>
<body class="d-flex flex-column h-100 bg-dark text-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/auth/home">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/auth/tos">Terms of Service</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/auth/privacy">Privacy</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/auth/account-deletion">Account Deletion</a>
                </li>
				<li class="nav-item">
                    <a class="nav-link" href="/auth/donate">Donate</a>
                </li>
            </ul>
        </div>

        <!-- Sora account area: guest = avatar + Log In, authenticated = avatar + username dropdown -->
        <div class="sora-account-area ms-auto">
            @if (Model.isAuthenticated)
            {
                <div class="dropdown">
                    <button class="sora-account-button dropdown-toggle"
                            type="button"
                            id="soraAccountMenu"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <img id="soraAccountAvatar"
                             class="sora-account-avatar"
                             src="/favicon.png"
                             alt="Profile">
                        <span id="soraAccountUsername">Profile</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end sora-account-menu"
                        aria-labelledby="soraAccountMenu">
                        <li>
                            <a class="dropdown-item sora-account-item"
                               href="/users/@Model.userSession.userId/profile">
                                <i class="bi bi-person"></i>
                                <span>View Profile</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button type="button"
                                    class="dropdown-item sora-account-item sora-logout-button"
                                    id="soraLogoutButton">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="sora-login-button" href="/auth/accountlogin">
                    <i class="bi bi-person-circle sora-login-icon"></i>
                    <span>Log In</span>
                </a>
            }
        </div>
    </div>
</nav>
@if (Model.isAuthenticated)
{
    <nav class="navbar navbar-expand-lg navbar-black navbar-auth bg-black pt-0 pb-0">
        <div class="container-fluid">
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/home">Marine Home</a>
                    </li>
                    @{
                        /*
                    <li class="nav-item">
                        <a class="nav-link" href="/internal/age">18+ Verification</a>
                    </li>
                    */
                    }
                    <li class="nav-item">
                        <a class="nav-link text-light" href="/auth/2fa">2FA</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" href="/internal/membership">Membership Type</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" href="/internal/tixexchange">Tix Exchange</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" href="/internal/robuxexchange">Robux Exchange</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" href="/internal/collectibles?userId=@Model.userSession.userId">My Collectibles</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" href="/internal/create-place">Create a place</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
}
<main class="flex-shrink-0 bg-dark">
    @RenderBody()
</main>
<footer class="footer mt-auto py-3 bg-dark">
    <div class="container">
        <p class="text-muted">This website is not affiliated, endorsed, and/or sponsored by any companies, trademarks, or copyrighted names mentioned. No copyright infringement is intended.</p>
        <p class="text-muted mb-0">&copy; @DateTime.UtcNow.Year @Roblox.Configuration.BaseUrl.Replace("https://", "").Replace("http://", "")</p>
    </div>
</footer>


@if (Model.isAuthenticated)
{
    <script>
        (function () {
            var userId = @Model.userSession.userId;
            var usernameElement = document.getElementById("soraAccountUsername");
            var avatarElement = document.getElementById("soraAccountAvatar");
            var logoutButton = document.getElementById("soraLogoutButton");

            function setFallbackAvatar() {
                if (avatarElement) {
                    avatarElement.src = "/favicon.png";
                }
            }

            // Load the current username from the existing Sora users API.
            fetch("/apisite/users/v1/users/" + userId, {
                credentials: "same-origin"
            })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error("User request failed");
                }
                return response.json();
            })
            .then(function (user) {
                if (usernameElement && user && user.name) {
                    usernameElement.textContent = user.name;
                }
            })
            .catch(function () {
                if (usernameElement) {
                    usernameElement.textContent = "Profile";
                }
            });

            // Load the current user's headshot through Sora's thumbnail API.
            fetch("/apisite/thumbnails/v1/users/avatar-headshot?userIds=" + userId + "&size=150x150&format=Png&isCircular=false", {
                credentials: "same-origin"
            })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error("Avatar request failed");
                }
                return response.json();
            })
            .then(function (result) {
                if (avatarElement &&
                    result &&
                    result.data &&
                    result.data.length &&
                    result.data[0].imageUrl) {
                    avatarElement.src = result.data[0].imageUrl;
                } else {
                    setFallbackAvatar();
                }
            })
            .catch(function () {
                setFallbackAvatar();
            });

            if (logoutButton) {
                logoutButton.addEventListener("click", function () {
                    logoutButton.disabled = true;

                    fetch("/apisite/auth/v2/logout", {
                        method: "POST",
                        credentials: "same-origin"
                    })
                    .then(function () {
                        window.location.href = "/auth/home";
                    })
                    .catch(function () {
                        // The server may already have deleted the session.
                        window.location.href = "/auth/home";
                    });
                });
            }
        })();
    </script>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
</body>
</html>